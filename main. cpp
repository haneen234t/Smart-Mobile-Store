#include <iostream>
#include <string>
#include <vector>

using namespace std;

class SmartPhone {
private:
    int id;
    string name;
    double price;
    int quantity;
    string os;

public:
    SmartPhone(int phoneId, string phoneName, double phonePrice,
               int phoneQuantity, string phoneOS) {
        id = phoneId;
        name = phoneName;
        price = phonePrice;
        quantity = phoneQuantity;
        os = phoneOS;
    }

    virtual ~SmartPhone() {}

    int getId() { return id; }
    string getName() { return name; }
    double getPrice() { return price; }
    int getQuantity() { return quantity; }
    string getOS() { return os; }

    void buyOne() {
        if (quantity > 0) {
            quantity--;
        }
    }

    virtual void printDetails() {
        cout << "ID: " << id
             << " | Name: " << name
             << " | Price: $" << price
             << " | Qty: " << quantity << " available"
             << " | OS: " << os << endl;
    }
};

class PremiumPhone : public SmartPhone {
private:
    string extraFeature;

public:
    PremiumPhone(int phoneId, string phoneName, double phonePrice,
                 int phoneQuantity, string phoneOS, string extra)
        : SmartPhone(phoneId, phoneName, phonePrice,
                     phoneQuantity, phoneOS) {
        extraFeature = extra;
    }

    void printDetails() override {
        SmartPhone::printDetails();
        cout << "   -> Extra Feature: "
             << extraFeature << endl;
    }
};

class MobileStore {
private:
    vector<SmartPhone*> inventory;

public:
    void addPhone(int id, string name, double price,
                  int qty, string os) {
        inventory.push_back(
            new SmartPhone(id, name, price, qty, os)
        );
    }

    void addPhone(int id, string name, double price,
                  int qty, string os, string extra) {
        inventory.push_back(
            new PremiumPhone(id, name, price, qty, os, extra)
        );
    }

    void showInventory() {
        if (inventory.empty()) {
            cout << "The store is empty. Admin needs to add phones first!"
                 << endl;
            return;
        }

        for (int i = 0; i < inventory.size(); i++) {
            inventory[i]->printDetails();
        }
    }

    void sellPhone(int searchId) {
        for (int i = 0; i < inventory.size(); i++) {
            if (inventory[i]->getId() == searchId) {
                if (inventory[i]->getQuantity() > 0) {
                    inventory[i]->buyOne();

                    cout << "\n[SUCCESS] You bought "
                         << inventory[i]->getName()
                         << " successfully!\n";
                    return;
                }
                else {
                    cout << "\n[SORRY] This phone is out of stock!\n";
                    return;
                }
            }
        }

        cout << "\n[ERROR] Phone ID not found in the store!\n";
    }

    ~MobileStore() {
        for (int i = 0; i < inventory.size(); i++) {
            delete inventory[i];
        }
    }
};

int main() {
    MobileStore shop;
    int roleChoice;

    do {
        cout << "\n=========================================\n";
        cout << "       MAIN SYSTEM MENU (CHOOSE ROLE)    \n";
        cout << "=========================================\n";
        cout << "1. Login as ADMIN (Add Phones)\n";
        cout << "2. Login as CUSTOMER (Browse & Buy)\n";
        cout << "3. Close Application\n";
        cout << "Enter your role (1-3): ";

        cin >> roleChoice;

        if (roleChoice == 1) {
            int adminChoice;

            do {
                cout << "\n--- ADMIN PANEL ---\n";
                cout << "1. Add New Phone to Store\n";
                cout << "2. Back to Main Menu\n";
                cout << "Enter choice: ";

                cin >> adminChoice;

                if (adminChoice == 1) {
                    int id, qty, type;
                    string name, os;
                    double price;

                    cout << "Select Phone Type (1. Standard, 2. Premium): ";
                    cin >> type;

                    cout << "Enter custom Phone ID: ";
                    cin >> id;

                    cin.ignore();

                    cout << "Enter Phone Name: ";
                    getline(cin, name);

                    cout << "Enter Price: $";
                    cin >> price;

                    cout << "Enter Quantity: ";
                    cin >> qty;

                    cin.ignore();

                    cout << "Enter Operating System (OS): ";
                    getline(cin, os);

                    if (type == 2) {
                        string extra;

                        cout << "Enter Extra Feature details: ";
                        getline(cin, extra);

                        shop.addPhone(id, name, price, qty, os, extra);
                    }
                    else {
                        shop.addPhone(id, name, price, qty, os);
                    }

                    cout << "\n[SYSTEM] Phone added successfully by Admin!\n";
                }

            } while (adminChoice != 2);
        }

        else if (roleChoice == 2) {
            int customerChoice;

            do {
                cout << "\n--- CUSTOMER PORTAL ---\n";
                cout << "1. Display All Available Phones & Prices\n";
                cout << "2. Buy a Phone (Enter ID)\n";
                cout << "3. Back to Main Menu\n";
                cout << "Enter choice (1-3): ";

                cin >> customerChoice;

                if (customerChoice == 1) {
                    cout << "\n--- Current Store Inventory ---\n";
                    shop.showInventory();
                    cout << "-------------------------------\n";
                }
                else if (customerChoice == 2) {
                    int targetId;

                    cout << "Enter the ID of the phone you want to buy: ";
                    cin >> targetId;

                    shop.sellPhone(targetId);
                }

            } while (customerChoice != 3);
        }

    } while (roleChoice != 3);

    cout << "\nApplication closed. Thank you!\n";

    return 0;
}
